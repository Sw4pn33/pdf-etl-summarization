{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "panel", "id": "barchart", "name": "Bar Chart", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time Series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "PDF Summarization Service - KPI Dashboard",
  "uid": "pdf-summarization-v1",
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Total PDFs Processed (All Domains)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "sum(pdfs_processed_total)", "legendFormat": "Total PDFs", "refId": "A" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 2,
      "title": "Avg Processing Time (seconds)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "pdf_avg_processing_time_seconds", "legendFormat": "Avg Time", "refId": "A" }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "steps": [
            { "value": null, "color": "green" },
            { "value": 30, "color": "yellow" },
            { "value": 60, "color": "red" }
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Avg Word Count by Domain",
      "type": "barchart",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "pdf_avg_word_count", "legendFormat": "{{domain}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Panel 1: Avg Reading Level - Summary vs Original (by Domain)",
      "type": "barchart",
      "description": "Compares Flesch-Kincaid grade level of original documents vs their generated summaries.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 10 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "pdf_reading_level_original", "legendFormat": "Original - {{domain}}", "refId": "A" },
        { "expr": "pdf_reading_level_summary", "legendFormat": "Summary - {{domain}}", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none" }
        }
      },
      "options": {
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 5,
      "title": "Panel 2: Daily Processing Volume by Document Domain",
      "type": "timeseries",
      "description": "Tracks how many PDFs are processed daily, broken down by document domain.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 10 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "increase(pdfs_processed_total[1d])", "legendFormat": "{{domain}}", "refId": "A" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20, "spanNulls": true }
        }
      }
    },
    {
      "id": 6,
      "title": "Reading Level Score Distribution (Summaries)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(pdf_reading_level_distribution_bucket[1h]))", "legendFormat": "p50 (Median)", "refId": "A" },
        { "expr": "histogram_quantile(0.9, rate(pdf_reading_level_distribution_bucket[1h]))", "legendFormat": "p90", "refId": "B" },
        { "expr": "histogram_quantile(0.95, rate(pdf_reading_level_distribution_bucket[1h]))", "legendFormat": "p95", "refId": "C" }
      ]
    },
    {
      "id": 7,
      "title": "PDFs Processed by Domain",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "pdfs_processed_total", "legendFormat": "{{domain}}", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "domain",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(pdfs_processed_total, domain)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  }
}
